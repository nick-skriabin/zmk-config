#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <54>; };

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE LEFT_ALT RIGHT_ALT LEFT_GUI RIGHT_GUI>; };

/ {
    combos {
        compatible = "zmk,combos";

        l_sqb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 15>;
            layers = <0 1>;
        };

        l_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            layers = <0 1>;
        };

        r_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 19>;
            layers = <0 1>;
        };

        r_sqb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <21 20>;
            layers = <0 1>;
        };

        col {
            bindings = <&kp COLON>;
            key-positions = <2 3>;
            layers = <0 1>;
        };

        semi {
            bindings = <&kp SEMI>;
            key-positions = <8 9>;
            layers = <0 1>;
        };
    };

    macros {
        tm_tog_col: tm_tog_col {
            compatible = "zmk,behavior-macro";
            label = "TM_TOG_COL";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp Z>;
        };

        tm_sess_sw: tm_sess_sw {
            compatible = "zmk,behavior-macro";
            label = "Tmux: Switch Session";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp LS(T)>;
        };

        tm_tog_sc: tm_tog_sc {
            compatible = "zmk,behavior-macro";
            label = "TM_TOG_SC";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp LEFT_BRACKET>;
        };

        tm_win_n: tm_win_n {
            compatible = "zmk,behavior-macro";
            label = "Go to next tmux window";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp N>;
        };

        tm_win_p: tm_win_p {
            compatible = "zmk,behavior-macro";
            label = "TM_WIN_P";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp P>;
        };

        tm_sess_n: tm_sess_n {
            compatible = "zmk,behavior-macro";
            label = "TM_SESS_N";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp LEFT_PARENTHESIS>;
        };

        tm_sess_p: tm_sess_p {
            compatible = "zmk,behavior-macro";
            label = "TM_SESS_P";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp RIGHT_PARENTHESIS>, <&macro_press>;
        };

        tog_ru: tog_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(LG(F6)))) &to 0>;
            label = "TOG_RU";
        };

        tog_en: tog_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(LG(F5)))) &to 1>;
            label = "TOG_EN";
        };
    };

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 40 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 41>;
            require-prior-idle-ms = <150>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <37 38 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36>;
            require-prior-idle-ms = <150>;
        };

        q_esc: q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans      &q_esc        &kp W             &kp E          &kp R          &kp T        &kp Y        &kp U            &kp I          &kp O         &kp P            &none
&tog_en     &hm_l LGUI A  &hm_l LEFT_ALT S  &hm_l LCTRL D  &hm_l LSHFT F  &kp G        &kp H        &hm_r RSHIFT J   &hm_r RCTRL K  &hm_r RALT L  &hm_r RGUI SEMI  &kp SQT
&caps_word  &kp Z         &kp X             &kp C          &kp V          &kp B        &kp N        &kp M            &kp COMMA      &kp DOT       &kp FSLH         &none
                                            &none          &lt 2 SPACE    &lt 3 TAB    &lt 4 ENTER  &lt 5 BACKSPACE  &none
            >;

            label = "DEF";
        };

        COL {
            bindings = <
&trans      &q_esc            &kp W             &kp F          &kp P          &kp B        &kp J        &kp L            &kp U          &kp Y         &kp SEMI      &none
&tog_ru     &hm_l LEFT_GUI A  &hm_l LEFT_ALT R  &hm_l LCTRL S  &hm_l LSHFT T  &kp G        &kp M        &hm_r RSHIFT N   &hm_r RCTRL E  &hm_r RALT I  &hm_r RGUI O  &kp APOS
&caps_word  &kp X             &kp C             &kp D          &kp V          &kp Z        &kp K        &kp H            &kp COMMA      &kp DOT       &kp FSLH      &none
                                                &none          &lt 2 SPACE    &lt 3 TAB    &lt 4 ENTER  &lt 5 BACKSPACE  &none
            >;

            label = "COL";
        };

        TMUX {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &tm_sess_n  &tm_sess_p   &trans       &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &tm_tog_sc  &tm_tog_col  &tm_sess_sw  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &tm_win_p    &tm_win_n    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans      &trans       &trans
            >;

            label = "TMUX";
        };

        NUM {
            label = "NUM";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp LEFT_BRACKET  &kp N7  &kp N8  &kp N9  &kp N0         &kp RIGHT_BRACKET
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp SEMICOLON     &kp N4  &kp N5  &kp N6  &kp MINUS      &kp EQUAL
&trans  &trans    &trans    &trans     &trans     &trans    &kp GRAVE         &kp N1  &kp N2  &kp N3  &kp BACKSLASH  &trans
                            &trans     &trans     &trans    &trans            &trans  &trans
            >;
        };

        NAV {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp LC(N1)            &kp LC(N2)             &kp LC(N3)        &kp LC(N4)  &kp LC(N5)    &kp LC(N6)  &kp LC(N7)  &kp LC(N8)  &kp LC(N9)  &kp LC(N0)  &trans
&trans  &kp LGUI              &kp LALT               &kp LEFT_CONTROL  &kp LSHFT   &trans        &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &trans
&trans  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &trans            &trans      &trans        &trans      &trans      &trans      &trans      &trans      &trans
                                                     &trans            &trans      &trans        &trans      &trans      &trans
            >;

            label = "NAV";
        };

        MED {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_PP  &kp C_NEXT            &kp C_VOL_DN          &kp C_VOL_UP  &kp K_MUTE  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp RCTRL     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans                &trans                &trans        &trans      &trans
                        &trans  &trans  &trans    &trans    &trans                &trans
            >;

            label = "MED";
        };
    };
};
