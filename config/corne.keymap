#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&led_strip { chain-length = <54>; };

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE LEFT_ALT RIGHT_ALT LEFT_GUI RIGHT_GUI>; };

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        tm_tog_col: tm_tog_col {
            compatible = "zmk,behavior-macro";
            label = "TM_TOG_COL";
            #binding-cells = <0>;
            bindings = <&kp LC(T) &kp Z>;
        };

        tm_sess_sw: tm_sess_sw {
            compatible = "zmk,behavior-macro";
            label = "Tmux: Switch Session";
            #binding-cells = <0>;
            bindings = <&kp LC(T) &kp LS(F)>;
        };

        tm_tog_sc: tm_tog_sc {
            compatible = "zmk,behavior-macro";
            label = "TM_TOG_SC";
            #binding-cells = <0>;
            bindings = <&kp LC(T) &kp LEFT_BRACKET>;
        };

        tm_win_n: tm_win_n {
            compatible = "zmk,behavior-macro";
            label = "Go to next tmux window";
            #binding-cells = <0>;
            bindings = <&kp LC(T) &kp J>;
        };

        tm_win_p: tm_win_p {
            compatible = "zmk,behavior-macro";
            label = "TM_WIN_P";
            #binding-cells = <0>;
            bindings = <&kp LC(T) &kp SEMICOLON>;
        };
    };

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 40 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 41 37 38>;
            require-prior-idle-ms = <150>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <37 38 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 39 40>;
            require-prior-idle-ms = <150>;
        };

        q_esc: q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TILDE   &q_esc            &kp W             &lt 4 E        &lt 5 R        &kp T        &kp Y        &kp U            &kp I          &kp O         &kp P            &hm_r C_SLEEP LEFT_BRACKET
&kp ESC     &lt 3 A           &hm_l LEFT_ALT S  &hm_l LCTRL D  &hm_l LSHFT F  &kp G        &kp H        &hm_r RSHIFT J   &hm_r RCTRL K  &hm_r RALT L  &lt 3 SEMI       &kp SQT
&caps_word  &hm_l LEFT_GUI Z  &kp X             &kp C          &kp V          &kp B        &kp N        &kp M            &kp COMMA      &kp DOT       &hm_r RGUI FSLH  &none
                                                &none          &lt 2 SPACE    &lt 1 TAB    &lt 1 ENTER  &lt 2 BACKSPACE  &none
            >;

            label = "DEF";
        };

        NUM {
            label = "NUM";
            bindings = <
&trans  &trans    &trans    &trans     &kp LG(SPACE)  &trans    &kp LEFT_BRACKET  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp N0         &kp RIGHT_BRACKET
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT      &trans    &kp SEMICOLON     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS      &kp EQUAL
&trans  &trans    &trans    &trans     &trans         &trans    &kp GRAVE         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BACKSLASH  &trans
                            &trans     &trans         &trans    &trans            &trans           &trans
            >;
        };

        TMUX {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &tm_win_p  &tm_tog_col  &tm_tog_sc  &tm_sess_sw  &tm_win_n    &trans    &trans                &trans          &trans     &trans  &trans
&trans  &trans     &kp LALT     &kp LCTRL   &kp LSHFT    &trans       &kp LEFT  &kp DOWN_ARROW        &kp UP_ARROW    &kp RIGHT  &trans  &trans
&trans  &kp LGUI   &trans       &trans      &trans       &trans       &trans    &kp LG(LS(NUMBER_4))  &kp LG(LS(N5))  &trans     &trans  &trans
                                &trans      &trans       &trans       &trans    &trans                &trans
            >;

            label = "TMUX";
        };

        SYM {
            bindings = <
&trans  &kp AT       &kp PLUS       &kp MINUS   &kp AMPS              &kp PIPE                 &kp AT     &kp LBKT              &kp RBKT               &kp BACKSLASH     &trans  &trans
&trans  &kp PERCENT  &kp LESS_THAN  &kp EXCL    &kp EQUAL             &kp HASH                 &kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &trans  &trans
&trans  &trans       &kp UNDER      &kp DOLLAR  &kp CARET             &kp ASTRK                &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SLASH         &trans  &trans
                                    &trans      &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)    &kp LG(C)  &kp LG(V)             &trans
            >;
        };

        FUN {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans
&trans  &trans    &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp LGUI  &trans    &trans     &trans     &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                            &trans     &trans     &trans    &trans  &trans  &trans
            >;
        };

        MED {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_BRI_DN  &kp C_BRI_UP       &trans           &trans            &trans      &kp K_SLEEP
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_PLAY_PAUSE  &kp C_PREV  &kp C_NEXT
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans             &trans           &trans            &trans      &trans
                        &trans  &trans  &trans    &trans        &trans             &trans
            >;
        };
    };
};
